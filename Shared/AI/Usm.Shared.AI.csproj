<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Usm.Shared.AI</AssemblyName>
    <RootNamespace>Usm.Shared.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Abstractions\**\*.cs" />
    <Compile Remove="Agents\**\*.cs" />
    <Compile Remove="Chat\**\*.cs" />
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Embeddings\**\*.cs" />
    <Compile Remove="Infrastructure\**\*.cs" />
    <Compile Remove="ML\**\*.cs" />
    <Compile Remove="Memory\**\*.cs" />
    <Compile Remove="Prompting\**\*.cs" />
    <Compile Remove="RAG\**\*.cs" />
    <Compile Remove="Utilities\**\*.cs" />
    <Compile Remove="Providers\**\*.cs" />
    <Compile Remove="Extensions\DependencyInjection.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.ML" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="python_worker\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
